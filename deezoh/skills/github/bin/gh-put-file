#!/usr/bin/env python3
"""Upload a local file to a GitHub repo (creates or updates).

Usage:
    gh-put-file OWNER/REPO /local/path repo/path [--message "msg"]

Prints the commit SHA on success.
"""
import base64
import json
import os
import sys
import urllib.request
import urllib.error

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
import dynamic_credentials as dc

CREDENTIAL_NAME = "custom.github"
ALLOWED_HOSTS = ["api.github.com"]
BASE = "https://api.github.com"


def api(method, path, data=None):
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(BASE + path, data=body, method=method)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    if body:
        req.add_header("Content-Type", "application/json")
    dc.add_surrogate_to_request(req, CREDENTIAL_NAME, allowed_hosts=ALLOWED_HOSTS)
    try:
        return dc.read_json_response(urllib.request.urlopen(req, timeout=30))
    except urllib.error.HTTPError as exc:
        detail = exc.read(2048).decode(errors="replace")
        raise RuntimeError(f"HTTP {exc.code}: {detail}")


def main(argv):
    if len(argv) < 4:
        print(__doc__, file=sys.stderr)
        return 2
    owner_repo, local_path, repo_path = argv[1], argv[2], argv[3]
    message = "Update " + repo_path
    if "--message" in argv:
        message = argv[argv.index("--message") + 1]

    with open(os.path.expanduser(local_path), "rb") as f:
        content = base64.b64encode(f.read()).decode()

    payload = {"message": message, "content": content}
    try:
        existing = api("GET", f"/repos/{owner_repo}/contents/{repo_path}")
        payload["sha"] = existing["sha"]
    except RuntimeError:
        pass  # new file

    result = api("PUT", f"/repos/{owner_repo}/contents/{repo_path}", payload)
    print(result["commit"]["sha"])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (RuntimeError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
